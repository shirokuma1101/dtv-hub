TZ=Asia/Tokyo
MIRAKURUN_HOST=192.168.2.10
MIRAKURUN_PORT=40772
TAILSCALE_IMAGE=tailscale/tailscale:stable
TS_HOSTNAME=dtv-hub
# Optional: non-ephemeral auth key. Leave blank for interactive login (see README).
TS_AUTHKEY=
# Optional Discord webhook. Empty disables recording notifications.
DISCORD_WEBHOOK_URL=
# Use the central Ubuntu LAN address to allow LAN clients.
EPGSTATION_BIND_ADDRESS=127.0.0.1
EPGSTATION_PORT=13000
# External browser-facing port: set 443 for HTTPS reverse proxy; blank for direct access.
EPGSTATION_CLIENT_SOCKETIO_PORT=
MIRAKC_BIND_ADDRESS=127.0.0.1
MIRAKC_PORT=13001
MIRAKC_IMAGE=mirakc/mirakc:debian
EPGSTATION_REF=v2.10.0
MARIADB_IMAGE=mariadb:10.11
MARIADB_DATABASE=epgstation
MARIADB_USER=epgstation
MARIADB_PASSWORD=replace-with-a-long-random-password
MARIADB_ROOT_PASSWORD=replace-with-another-long-random-password
# Start with a local directory. Later switch to /mnt/recorded after mounting TrueNAS.
RECORDING_DIRECTORY=./recorded
