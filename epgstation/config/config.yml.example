      - name: 240p
        cmd: '%FFMPEG% -analyzeduration 2000000 -probesize 2000000 -i pipe:0 -map 0:v:0 -map 0:a:0? -sn -dn -threads 2 -c:v libx264 -vf yadif,scale=trunc(240*dar/2)*2:240,setsar=1 -preset veryfast -pix_fmt yuv420p -b:v 300k -maxrate 300k -bufsize 600k -g 60 -sc_threshold 0 -c:a aac -ar 48000 -b:a 64k -ac 2 -movflags frag_keyframe+empty_moov+default_base_moof -f mp4 pipe:1'
      - name: 360p
        cmd: '%FFMPEG% -analyzeduration 2000000 -probesize 2000000 -i pipe:0 -map 0:v:0 -map 0:a:0? -sn -dn -threads 2 -c:v libx264 -vf yadif,scale=trunc(360*dar/2)*2:360,setsar=1 -preset veryfast -pix_fmt yuv420p -b:v 650k -maxrate 650k -bufsize 1300k -g 60 -sc_threshold 0 -c:a aac -ar 48000 -b:a 96k -ac 2 -movflags frag_keyframe+empty_moov+default_base_moof -f mp4 pipe:1'
      - name: 480p
        cmd: '%FFMPEG% -analyzeduration 2000000 -probesize 2000000 -i pipe:0 -map 0:v:0 -map 0:a:0? -sn -dn -threads 2 -c:v libx264 -vf yadif,scale=trunc(480*dar/2)*2:480,setsar=1 -preset veryfast -pix_fmt yuv420p -b:v 1200k -maxrate 1200k -bufsize 2400k -g 60 -sc_threshold 0 -c:a aac -ar 48000 -b:a 128k -ac 2 -movflags frag_keyframe+empty_moov+default_base_moof -f mp4 pipe:1'
      - name: 1080p
        cmd: '%FFMPEG% -analyzeduration 2000000 -probesize 2000000 -i pipe:0 -map 0:v:0 -map 0:a:0? -sn -dn -threads 2 -c:v libx264 -vf yadif,scale=trunc(1080*dar/2)*2:1080,setsar=1 -preset veryfast -pix_fmt yuv420p -b:v 5000k -maxrate 5000k -bufsize 10000k -g 60 -sc_threshold 0 -c:a aac -ar 48000 -b:a 192k -ac 2 -movflags frag_keyframe+empty_moov+default_base_moof -f mp4 pipe:1'
